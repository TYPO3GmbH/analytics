<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:analytics/Resources/Private/Language/locallang.xlf" product-name="analytics">
        <body>
            <trans-unit id="flash.error.title" resname="flash.error.title">
                <source>Error</source>
                <target>Fehler</target>
            </trans-unit>
            <trans-unit id="flash.invalidInput" resname="flash.invalidInput">
                <source>Invalid input.</source>
                <target>Ungültige Eingabe.</target>
            </trans-unit>
            <trans-unit id="flash.siteNotFound" resname="flash.siteNotFound">
                <source>Site not found.</source>
                <target>Site nicht gefunden.</target>
            </trans-unit>
            <trans-unit id="flash.registrationFailed" resname="flash.registrationFailed">
                <source>Registration failed: %s</source>
                <target>Registrierung fehlgeschlagen: %s</target>
            </trans-unit>
            <trans-unit id="flash.apiResponseIncomplete" resname="flash.apiResponseIncomplete">
                <source>API response incomplete.</source>
                <target>API-Antwort unvollständig.</target>
            </trans-unit>
            <trans-unit id="flash.statusFetchFailed" resname="flash.statusFetchFailed">
                <source>Status query failed. Please check the registration.</source>
                <target>Statusabfrage fehlgeschlagen. Bitte prüfe die Registrierung.</target>
            </trans-unit>
            <trans-unit id="flash.dashboardUrlUnavailable" resname="flash.dashboardUrlUnavailable">
                <source>Dashboard URL could not be retrieved.</source>
                <target>Dashboard-URL konnte nicht abgerufen werden.</target>
            </trans-unit>
            <trans-unit id="flash.managePlanUrlUnavailable" resname="flash.managePlanUrlUnavailable">
                <source>Manage plan URL could not be retrieved.</source>
                <target>Manage-Plan-URL konnte nicht abgerufen werden.</target>
            </trans-unit>
            <trans-unit id="flash.success.title" resname="flash.success.title">
                <source>Registration successful</source>
                <target>Registrierung erfolgreich</target>
            </trans-unit>
            <trans-unit id="flash.success.registered" resname="flash.success.registered">
                <source>Site "%s" successfully registered.</source>
                <target>Site „%s“ erfolgreich registriert.</target>
            </trans-unit>
            <trans-unit id="backend.headline" resname="backend.headline">
                <source>TYPO3 Analytics</source>
                <target>TYPO3 Analytics</target>
            </trans-unit>
            <trans-unit id="backend.intro" resname="backend.intro">
                <source>This module shows all configured TYPO3 sites and their Analytics status. Sites that are not yet registered can be registered directly. Dashboard, plan management and status updates are available for registered sites.</source>
                <target>Dieses Modul zeigt alle konfigurierten TYPO3-Sites und deren Analytics-Status. Noch nicht registrierte Sites können direkt angemeldet werden. Für registrierte Sites stehen Dashboard, Planverwaltung und Statusaktualisierung bereit.</target>
            </trans-unit>
            <trans-unit id="badge.registered" resname="badge.registered">
                <source>Registered</source>
                <target>Registriert</target>
            </trans-unit>
            <trans-unit id="badge.notRegistered" resname="badge.notRegistered">
                <source>Not registered</source>
                <target>Nicht registriert</target>
            </trans-unit>
            <trans-unit id="label.domain" resname="label.domain">
                <source>Domain</source>
                <target>Domain</target>
            </trans-unit>
            <trans-unit id="label.siteTitle" resname="label.siteTitle">
                <source>Site title</source>
                <target>Site-Titel</target>
            </trans-unit>
            <trans-unit id="label.websiteId" resname="label.websiteId">
                <source>Website ID</source>
                <target>Website ID</target>
            </trans-unit>
            <trans-unit id="label.status" resname="label.status">
                <source>Status</source>
                <target>Status</target>
            </trans-unit>
            <trans-unit id="label.package" resname="label.package">
                <source>Package</source>
                <target>Paket</target>
            </trans-unit>
            <trans-unit id="label.touchpoints" resname="label.touchpoints">
                <source>Touchpoints</source>
                <target>Touchpoints</target>
            </trans-unit>
            <trans-unit id="label.updatedAt" resname="label.updatedAt">
                <source>Updated at</source>
                <target>Aktualisiert am</target>
            </trans-unit>
            <trans-unit id="badge.exhausted" resname="badge.exhausted">
                <source>exhausted</source>
                <target>erschöpft</target>
            </trans-unit>
            <trans-unit id="button.dashboard" resname="button.dashboard">
                <source>Dashboard</source>
                <target>Dashboard</target>
            </trans-unit>
            <trans-unit id="button.managePlan" resname="button.managePlan">
                <source>Manage Plan</source>
                <target>Plan verwalten</target>
            </trans-unit>
            <trans-unit id="button.subscribePlan" resname="button.subscribePlan">
                <source>Subscribe plan</source>
                <target>Plan abschließen</target>
            </trans-unit>
            <trans-unit id="button.refreshStatus" resname="button.refreshStatus">
                <source>Refresh status</source>
                <target>Status aktualisieren</target>
            </trans-unit>
            <trans-unit id="button.register" resname="button.register">
                <source>Register</source>
                <target>Registrieren</target>
            </trans-unit>
            <trans-unit id="placeholder.registrationEmail" resname="placeholder.registrationEmail">
                <source>Email address for registration</source>
                <target>E-Mail-Adresse für Registrierung</target>
            </trans-unit>
            <trans-unit id="button.refresh" resname="button.refresh">
                <source>Refresh</source>
                <target>Aktualisieren</target>
            </trans-unit>
            <trans-unit id="button.backToOverview" resname="button.backToOverview">
                <source>Back to overview</source>
                <target>Zurück zur Übersicht</target>
            </trans-unit>
        </body>
