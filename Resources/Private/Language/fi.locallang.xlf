<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="fi" datatype="plaintext" original="EXT:analytics/Resources/Private/Language/locallang.xlf" product-name="analytics">
        <body>
            <trans-unit id="pagePerformance.views" resname="pagePerformance.views">
                <source>Views</source>
                <target>Sivun katselut</target>
            </trans-unit>
            <trans-unit id="pagePerformance.bounceRate" resname="pagePerformance.bounceRate">
                <source>Bounce rate</source>
                <target>Sivun poistumisprosentti</target>
            </trans-unit>
            <trans-unit id="pagePerformance.averageTimeOnPage" resname="pagePerformance.averageTimeOnPage">
                <source>Avg. time on page</source>
                <target>Sivun istunnon keskimääräinen kesto</target>
            </trans-unit>
            <trans-unit id="pagePerformance.tooltip.description.bounceRate" resname="pagePerformance.tooltip.description.bounceRate">
                <source>The percentage of visitors who left your website after viewing only one page, regardless of the duration of their visit or how they exited.</source>
                <target>Niiden käyntien prosenttiosuus, jotka poistuivat verkkosivustoltasi uudelleen vain yhden sivun tarkastelun jälkeen. Sillä ei ole merkitystä, kuinka kauan kävijä oli sivulla tai miten hän poistui. Kutsumme sitä &quot;hyppääjäksi&quot;, jos kyseessä on käynti, jossa on vain yksi vuorovaikutus verkkosivustosi kanssa.</target>
            </trans-unit>
        </body>
    </file>
