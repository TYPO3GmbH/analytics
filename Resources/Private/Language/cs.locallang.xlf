    <file source-language="en" target-language="cs" datatype="plaintext" original="EXT:analytics/Resources/Private/Language/locallang.xlf" product-name="analytics">
        <body>
            <trans-unit id="pagePerformance.views" resname="pagePerformance.views">
                <source>Views</source>
                <target>Zobrazení stránky</target>
            </trans-unit>
            <trans-unit id="pagePerformance.bounceRate" resname="pagePerformance.bounceRate">
                <source>Bounce rate</source>
                <target>Míra okamžitého opuštění stránky</target>
            </trans-unit>
            <trans-unit id="pagePerformance.averageTimeOnPage" resname="pagePerformance.averageTimeOnPage">
                <source>Avg. time on page</source>
                <target>Průměrná doba trvání relace stránky</target>
            </trans-unit>
            <trans-unit id="pagePerformance.tooltip.description.bounceRate" resname="pagePerformance.tooltip.description.bounceRate">
                <source>The percentage of visitors who left your website after viewing only one page, regardless of the duration of their visit or how they exited.</source>
                <target>Procento návštěv, které opustily váš web znovu pouze po zobrazení jedné stránky. Nezáleží na tom, jak dlouho byl návštěvník na stránce nebo jakým způsobem ji opustil. Jako &quot;&quot;bounce&quot;&quot; označujeme návštěvu, která proběhla pouze s jednou interakcí s vašimi webovými stránkami.</target>
            </trans-unit>
        </body>
