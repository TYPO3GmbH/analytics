    <file source-language="en" target-language="zh" datatype="plaintext" original="EXT:analytics/Resources/Private/Language/locallang.xlf" product-name="analytics">
        <body>
            <trans-unit id="pagePerformance.views" resname="pagePerformance.views">
                <source>Views</source>
                <target>页面浏览量</target>
            </trans-unit>
            <trans-unit id="pagePerformance.bounceRate" resname="pagePerformance.bounceRate">
                <source>Bounce rate</source>
                <target>页面的跳出率</target>
            </trans-unit>
            <trans-unit id="pagePerformance.averageTimeOnPage" resname="pagePerformance.averageTimeOnPage">
                <source>Avg. time on page</source>
                <target>平均页面会话持续时间</target>
            </trans-unit>
            <trans-unit id="pagePerformance.tooltip.description.bounceRate" resname="pagePerformance.tooltip.description.bounceRate">
                <source>The percentage of visitors who left your website after viewing only one page, regardless of the duration of their visit or how they exited.</source>
                <target>只浏览了一个页面就再次离开你的网站的访问百分比。访客在页面上停留多长时间或如何离开并不重要。如果是只有一次与你的网站互动的访问，我们称之为&quot;&quot;跳出&quot;&quot;。</target>
            </trans-unit>
        </body>
