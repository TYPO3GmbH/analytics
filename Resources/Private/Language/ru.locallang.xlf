<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="ru" datatype="plaintext" original="EXT:analytics/Resources/Private/Language/locallang.xlf" product-name="analytics">
        <body>
            <trans-unit id="pagePerformance.views" resname="pagePerformance.views">
                <source>Views</source>
                <target>Просмотры страниц</target>
            </trans-unit>
            <trans-unit id="pagePerformance.bounceRate" resname="pagePerformance.bounceRate">
                <source>Bounce rate</source>
                <target>Показатель отказов страницы</target>
            </trans-unit>
            <trans-unit id="pagePerformance.averageTimeOnPage" resname="pagePerformance.averageTimeOnPage">
                <source>Avg. time on page</source>
                <target>Средняя продолжительность сеанса страницы</target>
            </trans-unit>
            <trans-unit id="pagePerformance.tooltip.description.bounceRate" resname="pagePerformance.tooltip.description.bounceRate">
                <source>The percentage of visitors who left your website after viewing only one page, regardless of the duration of their visit or how they exited.</source>
                <target>Процент посещений, которые снова покинули ваш сайт только после одностраничного просмотра. Не имеет значения, как долго посетитель находился на странице и как он ушел. Мы называем это &quot;&quot;отскоком&quot;&quot;, если это посещение с единственным взаимодействием с вашим сайтом.</target>
            </trans-unit>
        </body>
    </file>
