includes:
    - phpstan-baseline.neon
    - %currentWorkingDirectory%/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false

    paths:
        - %currentWorkingDirectory%/Classes/

    bootstrapFiles:
        - phpstan.bootstrap-dashboard.php

    scanDirectories:
        - %currentWorkingDirectory%/.Build/dummy-typo3/vendor/typo3/cms-dashboard/Classes/
