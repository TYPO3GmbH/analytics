includes:
    - phpstan-baseline.neon
    - %currentWorkingDirectory%/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false

    paths:
        - %currentWorkingDirectory%/Classes/

    bootstrapFiles:
        - phpstan.bootstrap-typo3stubs.php
