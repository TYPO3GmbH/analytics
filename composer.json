{
  "name": "t3g/analytics",
  "description": "TYPO3 Analytics Extension",
  "type": "typo3-cms-extension",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-backend": "^13.4 || ^14.0",
    "typo3/cms-extbase": "^13.4 || ^14.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.4",
    "friendsofphp/php-cs-fixer": "^3.64",
    "typo3/testing-framework": "^8.0",
    "phpunit/phpunit": "^11.0",
    "ssch/typo3-rector": "^3.13",
    "saschaegerer/phpstan-typo3": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "T3G\\Analytics\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "T3G\\Analytics\\Tests\\": "Tests/"
    }
  },
  "version": "1.0.0-alpha",
  "extra": {
    "typo3/cms": {
      "extension-key": "analytics",
      "Package": {
        "providesPackages": {}
      }
    },
    "branch-alias": {
      "dev-develop": "dev-main"
    }
  },
  "scripts": {
    "dummy-typo3": "bash .ddev/commands/web/setup-dummy-typo3.sh",
    "t3g:typo3:composer-update": "composer --working-dir .Build/dummy-typo3 update",
    "t3g:rector:dry-run": "rector process --dry-run --config rector.php",
    "t3g:rector:fix": "rector process --config rector.php",
    "t3g:cgl": [
      "php-cs-fixer fix --config php-cs-fixer.php -v --dry-run --diff"
    ],
    "t3g:cgl:fix": [
      "php-cs-fixer fix --config php-cs-fixer.php"
    ],
    "t3g:phpstan": [
      "phpstan analyze --configuration phpstan.neon"
    ],
    "t3g:phpstan:create-baseline": [
      "phpstan analyze --configuration phpstan.neon --generate-baseline phpstan-baseline.neon"
    ],
    "t3g:test": "phpunit -c phpunit.xml",
    "t3g:test:unit": "phpunit -c phpunit.xml --testsuite unit",
    "t3g:test:functional": "phpunit -c phpunit.functional.xml"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  }
}
